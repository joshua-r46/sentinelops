POSTGRES_PASSWORD=replace_with_a_secure_password

# Phase 3 optional diagnosis-only gateway. Gemini is the default provider.
# Keep provider keys and service tokens in a protected local runtime environment.
LLM_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Separate operator token required to trigger paid diagnosis requests.
LLM_DIAGNOSIS_TOKEN=
# Legacy OpenAI-compatible provider settings (used only with LLM_PROVIDER=openai).
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_GATEWAY_TOKEN=

# Telegram notifications and restricted operator commands (polling opt-in).
TELEGRAM_BOT_TOKEN=
# Positive numeric Telegram user IDs allowed to issue commands in private chat.
TELEGRAM_ALLOWED_USER_IDS=
# Optional notification destination chat IDs; defaults to allowed user IDs.
TELEGRAM_ALLOWED_CHAT_IDS=
# Generate independent random service tokens; approval token must also be in
# APPROVER_TOKENS_JSON for the Phase 3 Safety Gate.
TELEGRAM_SERVICE_TOKEN=
TELEGRAM_APPROVER_TOKEN=
TELEGRAM_POLLING_ENABLED=false

# Optional Phase 3 approval operator tokens; Telegram approval token must match one entry.
APPROVER_TOKENS_JSON={}
APPROVAL_TTL_SECONDS=900

# Phase 4 isolated Executor (disabled unless explicitly enabled)
EXECUTOR_ENABLED=false
EXECUTOR_SHARED_SECRET=replace-with-at-least-32-random-bytes
DOCKER_GID=999
EXECUTION_TOKEN=replace-with-at-least-32-random-bytes

# Phase 5 independent post-action verifier
VERIFIER_TOKEN=replace-with-at-least-32-random-bytes
VERIFIER_PROBE_COUNT=3
VERIFIER_PROBE_INTERVAL=1

# Phase 6 pre-action snapshot manager (not enabled by default)
SNAPSHOT_TOKEN=replace-with-at-least-32-random-bytes
# Store this key in a separate protected file, not alongside database data.
SNAPSHOT_INTEGRITY_KEY_FILE=./secrets/snapshot_integrity_key
RECOVERY_OPERATOR_TOKENS_JSON={}
RECOVERY_APPROVER_TOKENS_JSON={}
RECOVERY_MAX_SNAPSHOT_AGE_SECONDS=86400
RECOVERY_MAX_ATTEMPTS_PER_INCIDENT=3
