POSTGRES_PASSWORD=replace_with_a_secure_password

# Phase 4 isolated Executor (disabled unless explicitly enabled)
EXECUTOR_ENABLED=false
EXECUTOR_SHARED_SECRET=replace-with-at-least-32-random-bytes
DOCKER_GID=999
EXECUTION_TOKEN=replace-with-at-least-32-random-bytes

# Phase 5 independent post-action verifier
VERIFIER_TOKEN=replace-with-at-least-32-random-bytes
VERIFIER_PROBE_COUNT=3
VERIFIER_PROBE_INTERVAL=1

# Phase 6 pre-action snapshot manager (not enabled by default)
SNAPSHOT_TOKEN=replace-with-at-least-32-random-bytes
# Store this key in a separate protected file, not alongside database data.
SNAPSHOT_INTEGRITY_KEY_FILE=./secrets/snapshot_integrity_key
RECOVERY_OPERATOR_TOKENS_JSON={}
RECOVERY_APPROVER_TOKENS_JSON={}
RECOVERY_MAX_SNAPSHOT_AGE_SECONDS=86400
RECOVERY_MAX_ATTEMPTS_PER_INCIDENT=3
